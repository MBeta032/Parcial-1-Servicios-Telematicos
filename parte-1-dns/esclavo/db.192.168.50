$ORIGIN .
$TTL 3600	; 1 hour
50.168.192.in-addr.arpa	IN SOA	ns1.empresa.local. admin.empresa.local. (
				2026090401 ; serial
				3600       ; refresh (1 hour)
				600        ; retry (10 minutes)
				1209600    ; expire (2 weeks)
				300        ; minimum (5 minutes)
				)
			NS	ns1.empresa.local.
			NS	ns2.empresa.local.
$ORIGIN 50.168.192.in-addr.arpa.
1			PTR	cliente.empresa.local.
10			PTR	pc01.empresa.local.
2			PTR	esclavo.empresa.local.
3			PTR	maestro.empresa.local.
