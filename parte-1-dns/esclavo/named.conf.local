//
// Do any local configuration here
//

// Consider adding the 1918 zones here, if they are not used in your
// organization
//include "/etc/bind/zones.rfc1918";

// ===== PARCIAL 1 - Clave TSIG =====
include "/etc/bind/keys/esclavo.key";

// Firmar todo lo que se le envíe al maestro
server 192.168.50.3 {
    keys { "esclavo-key"; };
};

// ===== PARCIAL 1 - Zona directa (COPIA) =====
zone "empresa.local" {
    type slave;
    file "/var/cache/bind/db.empresa.local";
    masters { 192.168.50.3; };
    transfer-source 192.168.50.2;
    notify-source 192.168.50.2;
    masterfile-format text;
};

// ===== PARCIAL 1 - Zona inversa (COPIA) =====
zone "50.168.192.in-addr.arpa" {
    type slave;
    file "/var/cache/bind/db.192.168.50";
    masters { 192.168.50.3; };
    transfer-source 192.168.50.2;
    notify-source 192.168.50.2;
    masterfile-format text;
};

// ===== PARCIAL 1 - AUDITORIA =====
logging {

        channel queries_log {
                file "/var/log/named/queries.log" versions 3 size 5m;
                severity info;
                print-time yes;
                print-category yes;
                print-severity yes;
        };

        channel transfers_log {
                file "/var/log/named/transfers.log" versions 3 size 5m;
                severity info;
                print-time yes;
                print-category yes;
                print-severity yes;
        };

        channel security_log {
                file "/var/log/named/security.log" versions 3 size 5m;
                severity info;
                print-time yes;
                print-category yes;
                print-severity yes;
        };

        channel ratelimit_log {
                file "/var/log/named/rate-limit.log" versions 3 size 5m;
                severity info;
                print-time yes;
                print-category yes;
        };

        category queries      { queries_log; };
        category xfer-out     { transfers_log; };
        category xfer-in      { transfers_log; };
        category notify       { transfers_log; };
        category security     { security_log; };
        category rate-limit   { ratelimit_log; };
};
