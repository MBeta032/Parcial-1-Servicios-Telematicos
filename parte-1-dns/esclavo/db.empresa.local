$ORIGIN .
$TTL 3600	; 1 hour
empresa.local		IN SOA	ns1.empresa.local. admin.empresa.local. (
				2026090402 ; serial
				3600       ; refresh (1 hour)
				600        ; retry (10 minutes)
				1209600    ; expire (2 weeks)
				300        ; minimum (5 minutes)
				)
			NS	ns1.empresa.local.
			NS	ns2.empresa.local.
			A	192.168.50.3
			MX	10 mail.empresa.local.
			AAAA	fd00:50::3
$ORIGIN empresa.local.
